#!/bin/sh
# Commits on this project carry the owner's name only. Removes any AI
# attribution line (Co-Authored-By: Claude…, "Generated with Claude Code",
# Claude session links) from the message before the commit is created.
# Authorship itself comes from user.name/user.email and is not touched.
sed -i -E \
  -e '/^[[:space:]]*[Cc][Oo]-[Aa][Uu][Tt][Hh][Oo][Rr][Ee][Dd]-[Bb][Yy]:.*([Cc]laude|[Aa]nthropic)/d' \
  -e '/[Gg]enerated with \[?[Cc]laude [Cc]ode/d' \
  -e '/^[[:space:]]*[Cc]laude-[Ss]ession:/d' \
  -e '/claude\.ai\/code\/session_/d' \
  "$1"
# drop trailing blank lines left behind
printf '%s\n' "$(cat "$1")" > "$1.tmp" && mv "$1.tmp" "$1"
