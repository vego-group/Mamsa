#!/usr/bin/env bash
# Refuse to push a monorepo-shaped ref to the backend-only remote.
# The mismatch is silent in git and only surfaces at merge time.
remote_name="$1"
[ "$remote_name" = "backend-api" ] || exit 0

while read -r local_ref local_sha _ _; do
    [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
    if git cat-file -e "$local_sha:backend" 2>/dev/null; then
        echo "✗ refusing: $local_ref is monorepo-shaped (it contains backend/)." >&2
        echo "  vego-group/mamsaa-backend-api holds the backend at its ROOT." >&2
        echo "  Use: scripts/push-backend.sh <remote-branch-name>" >&2
        exit 1
    fi
done
exit 0
# NOTE: this file is COMMITTED and active via `git config core.hooksPath .githooks`.
# A hook in .git/hooks lives in one clone only — the next person to clone gets
# no protection at all. Even this needs the config line to be set once per
# clone, so it is a convenience, not a control. The real control is a CI check
# on the PR that asserts the pushed tree's shape.
